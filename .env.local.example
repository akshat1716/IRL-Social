# =============================================================================
# IRL Social — Environment Variables Configuration Template
# Copy this file to `.env.local` and replace placeholders with real credentials
# =============================================================================

# 1. SUPABASE CONFIGURATION
# Public project URL and Anonymous API Key (Exposed to client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Only Service Role Key (NEVER prefix NEXT_PUBLIC, NEVER expose to browser)
# Required for payment settlements, atomic pass issuance, and role management
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. RAZORPAY PAYMENT GATEWAY & ENVIRONMENT MODES
# Payments mode: 'live' (production Razorpay API) or 'simulated' (local testing mode)
# Note: 'simulated' mode is strictly ignored when NODE_ENV === 'production'
PAYMENTS_MODE=simulated

# Razorpay Key ID (Publicly exposed for Razorpay Checkout JS SDK)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret & Webhook Secret (Server-only credentials)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
